# Robot registry entry — leeloo (Doosan m1013 arm)
# Sourced by gen_dataset.sh. Paths in ROBOT_CONFIG_FILE / WORLD_FILE refer to
# locations INSIDE the container (.sif); MASTER_IK_DIR is a host path relative to
# the project root.

# Empty -> curobo_ros falls back to its built-in default
# (curobo_doosan/src/m1013/m1013.yml). See config_manager.py:_load_robot_config.
ROBOT_CONFIG_FILE=""

# m1013 / leeloo base frame (curobo ConfigManager default).
BASE_LINK="base_0"

# Host directory (relative to project root) holding master_ik_data<voxel>.npz.
MASTER_IK_DIR="data"

# World file basename under data_generation/config/ (copied into the data bind).
WORLD_FILE="leeloo_world.yaml"

# Optional default camera frame for --mode real (override with --camera-frame).
DEFAULT_CAMERA_FRAME=""
